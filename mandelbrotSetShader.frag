precision mediump float;uniform vec2 u_resolution;uniform float u_time;int f(float a,float b){float x=0.;float y=0.;for(int i=0;i<500;i++){if(x*x+y*y>4.)return 0;float xN=x*x-y*y+a;float yN=2.*x*y+b;x=xN;y=yN;}return 1;}void main(){float z=1.*pow(.00005/1.,.5+.5*sin(u_time*.1));vec4 r=vec4(.2304-(.2304-.1)*z,.2304+(1.-.2304)*z,.52-(.52-.1)*z,.52+(1.-.52)*z);gl_FragColor=vec4(0,0,1,1);if(f(r.x+(gl_FragCoord.x/u_resolution.x)*(r.x-r.y),r.w-(gl_FragCoord.y/u_resolution.y)*(r.w-r.z))==1)gl_FragColor.z=0.;}